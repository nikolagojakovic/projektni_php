# Database — Railway provides this automatically when you add a PostgreSQL service
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# App
APP_URL=http://localhost:8080
APP_ENV=production
SESSION_SECRET=change_me_to_a_random_32_char_string

# SMTP Email (Resend, Mailgun, Gmail SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_api_key_here
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=ChatApp
